package build

//
// The meta-build, which does double duty.
//
// Its mvnDeps are what the root build.mill compiles against -- the same thing the
// root `//| mvnDeps` header would declare, written out because this file exists.
//
// And because it is also an UntemplateModule, the microsite's Scala and
// untemplates, under src/ and untemplate/ here, compile into that same classpath.
// That is what lets the root build's doc.genSite call
// com.mchange.commons.docsite.gen(...) as an ordinary function rather than
// spawning a JVM to run a generator main class.
//
// The cost of that convenience: the site code is compiled whenever anything in
// this build is, so a compile error in it fails every mill command, not just
// doc.*. And the doc module's sources end up split -- static/ in doc/, the Scala
// and untemplates here.
//
// super.mvnDeps() supplies com.mchange::untemplate, the runtime library the
// generated untemplate code calls into, pinned to the version untemplate-mill was
// built against. Naming it explicitly instead would invite the two drifting apart.
//

import mill.*, scalalib.*
import mill.meta.MillBuildRootModule

import untemplate.mill.UntemplateModule

object `package` extends MillBuildRootModule, UntemplateModule:

  override def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"com.mchange::mchange-java-build-checkers-mill::0.0.1",
    mvn"com.mchange::unstatic:0.4.0",
    mvn"com.mchange::unstatic-ztapir:0.4.0",
  )
