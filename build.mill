//| mill-version: 1.1.8
//| mvnDeps:
//| - com.mchange::mchange-java-build-checkers-millplugin::0.0.1-SNAPSHOT

package build

//
// The build for mchange-commons-java, a pure-Java library.
//
//   ./mill compile
//   ./mill test
//   ./mill jar | sourceJar | docJar | pom
//   ./mill publishLocal              # ~/.ivy2/local  (publishM2Local for ~/.m2)
//   ./mill publishSonatypeCentral
//   ./mill updateSite
//
// Modules mix in StringentJavaModule, so compiling also checks that every method
// which overrides something says so. ./mill <module>.overrideAnnotate writes copies
// of the offenders with @Override inserted, for a maintainer to review and copy
// across; it never edits the source tree.
//
// Layout is mill's default: src/ and resources/ for the library, test/src/ and
// test/resources/ for its tests.
//

import mill.*
import mill.javalib.*
import mill.javalib.publish.*
import mill.util.Jvm

import com.mchange.jbcs.millplugin.StringentJavaModule

object `package` extends StringentJavaModule, SonatypeCentralPublishModule {

  val orgName     = "com.mchange"
  val projectName = "mchange-commons-java"

  def artifactName     = projectName
  def publishVersion   = "0.7.0-SNAPSHOT"
  def pomPackagingType = PackagingType.Jar

  //
  // We emit 1.7 bytecode, which javac has refused to do since JDK 20. Rather
  // than depend on whatever JDK happens to be on PATH, ask coursier for a
  // JDK 11, the newest JDK that still accepts -source/-target 1.7.
  //
  def jvmVersion = "zulu:11"

  def javacOptions   = Seq("-source", "1.7", "-target", "1.7", "-Xlint:deprecation" /*, "-Xlint:unchecked"*/)
  def javadocOptions = Seq("-source", "1.7", "-Xdoclint:none")

  //
  // Every dependency of this library is optional. We compile against all of
  // them -- MLog picks a logging library at runtime, and the cfg package reads
  // HOCON if typesafe-config is present -- but downstream users should pull in
  // only what they actually use, so all of these are marked
  // <optional>true</optional> in the published POM.
  //
  // They are ordinary deps here rather than mill's Dep.optional(), because a
  // dep marked optional drops out of all downstream resolution, including our
  // own test classpath, which needs com.typesafe.config. So the optional flag
  // is set on the way into the POM instead, in publishXmlDeps below.
  //
  val optionalDeps = Seq(
    mvn"com.typesafe:config:1.3.0",
    mvn"log4j:log4j:1.2.14",
    mvn"org.apache.logging.log4j:log4j-api:2.17.1",
    mvn"org.apache.logging.log4j:log4j-core:2.17.1",
    mvn"org.slf4j:slf4j-api:1.7.5"
  )

  def mvnDeps = optionalDeps

  private lazy val optionalArtifacts = optionalDeps.map(d => Artifact.fromDepJava(d).artifact).toSet

  override def publishXmlDeps = Task.Anon {
    super.publishXmlDeps().map(d => if (optionalArtifacts(d.artifact)) d.copy(optional = true) else d)
  }

  def manifest = Task {
    super.manifest().add("Automatic-Module-Name" -> "com.mchange.mchangecommonsjava")
  }

  //
  // Some users want license files in the source jar, go figure.
  // See https://github.com/swaldman/mchange-commons-java/issues/11
  //
  def licenseFiles = Task.Sources("LICENSE", "LICENSE-LGPL", "LICENSE-EPL")

  override def sourceJar = Task {
    val extras = Task.dest / "extras"
    os.makeDir.all(extras)
    licenseFiles().foreach(pr => os.copy.into(pr.path, extras))
    PathRef(
      Jvm.createJar(
        Task.dest / "out.jar",
        (allSources() ++ resources() ++ compileResources()).map(_.path).filter(os.exists) :+ extras,
        manifest(),
        // Mill jars up whatever lives in the source folders, so skip the emacs
        // backup files .gitignore hides.
        fileFilter = (_, relPath) => !relPath.last.endsWith("~")
      )
    )
  }

  def pomSettings = PomSettings(
    description = "a library of arguably useful Java utilities.",
    organization = orgName,
    url = s"https://github.com/swaldman/$projectName",
    licenses = Seq(
      License(
        id = "LGPL-2.1",
        name = "GNU Lesser General Public License, Version 2.1",
        url = "http://www.gnu.org/licenses/lgpl-2.1.html",
        isOsiApproved = true,
        isFsfLibre = true,
        distribution = "repo"
      ),
      License(
        id = "EPL-1.0",
        name = "Eclipse Public License, Version 1.0",
        url = "http://www.eclipse.org/org/documents/epl-v10.html",
        isOsiApproved = true,
        isFsfLibre = true,
        distribution = "repo"
      )
    ),
    versionControl = VersionControl(
      browsableRepository = Some(s"git@github.com:swaldman/$projectName.git"),
      connection          = Some(s"scm:git:git@github.com:swaldman/$projectName")
    ),
    developers = Seq(
      Developer(
        id = "swaldman",
        name = "Steve Waldman",
        url = "https://github.com/swaldman",
        email = "swaldman@mchange.com"
      )
    )
  )

  //
  // SonatypeCentralPublishModule routes -SNAPSHOT versions to
  // https://central.sonatype.com/repository/maven-snapshots/ and bundles
  // releases for the Central Portal, so one command covers both:
  //
  //   ./mill publishSonatypeCentral
  //
  // Credentials come from MILL_SONATYPE_USERNAME / MILL_SONATYPE_PASSWORD
  // (or ~/.mill/credentials), signing key from MILL_PGP_SECRET_BASE64 /
  // MILL_PGP_PASSPHRASE.
  //

  object test extends JavaTests, StringentJavaModule, TestModule.Junit4 {

    // Only the library itself needs to be Java 7 compatible. Without this,
    // the tests would inherit the module's -source/-target 1.7.
    def javacOptions = Seq.empty[String]

    def mvnDeps = Seq(
      mvn"junit:junit:4.11",
      mvn"ch.qos.logback:logback-classic:1.1.2",
      mvn"com.novocode:junit-interface:0.11"
    )

    //
    // Arguments passed to the JUnit test runner (junit-interface).
    //
    //   -a  On a test failure, show the full stack trace and exception class for AssertionErrors.
    //       Without this, an assertion failure is reported only as its message, with no trace
    //       pointing at the failing line.
    //   -v  Verbose: log per-test "started"/"finished" events (rather than only a final summary),
    //       so you can see exactly which test classes and methods ran and in what order.
    //
    // See https://github.com/sbt/junit-interface
    //
    def testArgsDefault = Seq("-a", "-v")

    //
    // Run every test class in one JVM, serially.
    //
    // Several of the security-related tests (notably the com.mchange.v2.naming.junit
    // ReferenceIndirector / ReferenceableUtils / JavaBeanReferenceable cases) configure
    // behavior by mutating global System properties (e.g. OBJECT_FACTORY_WHITELIST,
    // allowIndirectSerializationViaReference) and rely on the absence of values they did
    // not set. Mill's parallelism spreads test classes over separate JVM processes, which
    // isolates those properties well enough, but a single serial JVM is the arrangement
    // these tests were written against and are known to pass under.
    //
    def testParallelism = false

    //
    // Mill forks the test JVM, so the options these tests want can just be set here:
    // assertions on, and the java.util.logging configuration the logging tests expect.
    //
    def forkArgs = Task {
      Seq(
        "-ea",
        s"-Djava.util.logging.config.file=${moduleDir / "resources" / "logging.properties"}"
      )
    }
  }

  //
  // Updates the project website on tickle.
  //
  // Only the javadocs are published: paradox/index.md was built by the sbt
  // build's paradox plugin, which has no mill equivalent, so that one page
  // needs a new home or a hand-written replacement.
  //
  def updateSite() = Task.Command {
    val apidocs = javadocGenerated().path
    val remote =
      s"tickle.mchange.com:/home/web/public/www.mchange.com/projects/${artifactName()}-versions/${publishVersion()}/apidocs"
    val local = os.list(apidocs).map(_.toString)
    Task.log.info(s"rsync -avz <${local.length} paths> $remote")
    os.proc("rsync", "-avz", local, remote).call(stdout = os.Inherit, stderr = os.Inherit)
    ()
  }
}

//
// One POM difference worth knowing about: mill omits test-scoped dependencies
// from the published POM, where the old sbt build listed them. It affects the
// POM only, not the build.
//
